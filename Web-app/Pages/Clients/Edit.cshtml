@page
@model Web_app.Pages.Clients.Edit
@{
    ViewData["Title"] = "Edit";
}
<div>
    <div class="container-flex bg-light pt-2 m-2 ">
        <p class="h3 p-2" >CUSTOMER EDIT</p>
        <input type="hidden" name="id" value="@Model.clientInfo.id" id="id">
        <form method="POST" class="p-2 m-4 text-primary" style="border: 2px solid #c0bdbd;">
            <input type="hidden" name="id" value="@Model.clientInfo.id">
            <div class="row p-2 ">
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label for="branch" class="form-label">Branch</label>
                    <select name="branch" id="branch" required class="form-select" >
                        <option value="" disabled selected>Select Branch</option>
                        <option value="R s Puram" selected="@(Model.clientInfo.branch == "R s Puram" ? "selected" : null)">R S Puram</option>
                        <option value="Ukkadam" selected="@(Model.clientInfo.branch == "Ukkadam" ? "selected" : null)">Ukkadam</option>
                        <option value="Sundharapuram" selected="@(Model.clientInfo.branch == "Sundharapuram" ? "selected" : null)">Sundharapuram</option>
                        <option value="Pollachi" selected="@(Model.clientInfo.branch == "Pollachi" ? "selected" : null)">Pollachi</option>
                        <option value="Sulur" selected="@(Model.clientInfo.branch == "Sulur" ? "selected" : null)">Sulur</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label class="form-label" for="customercode">Customer Code</label>
                    <input value="@Model.clientInfo.customer_code" name="customer_code" class="form-control" type="text" id="customercode">
                </div>
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label class="form-label" for="customername">Customer Name</label>
                    <input name="customer_name" value="@Model.clientInfo.customer_name" class="form-control" type="text" id="customername">
                </div>
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label class="form-label" for="category">Category</label>
                     <select class="form-select" name="status" id="category" required>
                        <option value="" selected disabled>Select Category</option>
                        <option value="1" selected="@(Model.clientInfo.status == "1" ? "selected" : null)">Active</option>
                        <option value="0" selected="@(Model.clientInfo.status == "0" ? "selected" : null)">Inactive</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label class="form-label" for="contactno">Contact No</label>
                    <input name="contact_no" value="@Model.clientInfo.contact_no" class="form-control" type="text" id="contactno">
                </div>
                <div class="col-12 col-md-6 col-lg-3 p-2">
                    <label class="form-label" for="email">Email</label>
                    <input value="@Model.clientInfo.email" name="email" class="form-control" type="text" id="email">
                    <label class="form-label" for="area">Area</label>
                    <input value="@Model.clientInfo.area" name="area" class="form-control" type="text" id="area">
                </div>
                <div class="col-12 col-sm-6 col-lg-6 p-2">
                        <label class="form-label" for="address">Address</label>
                        <textarea class="form-control" name="address" id="address" cols="30" rows="4" required>@Model.clientInfo.address</textarea>
                </div>
            </div>
            <div class="row">
                    @if(Model.successMessage.Length>0)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <strong>@Model.successMessage</strong>
                            <button type="button" data-bs-dismiss="alert"area-label="Close" class="btn-close" ></button>
                        </div>
                    }
                <div class="col-12 text-center mt-4">
                    <div class="p-4" style="perspective: 100px; border-top: 2px solid #c0bdbd;">
                        <button type="submit" class="btn text-white icon-link icon-link-hover" style="--bs-icon-link-transform: translate3d(0, -.3rem, 0); background-color: rgb(135, 85, 237); "><i class="fa-regular fa-floppy-disk bi"></i> Save</button>
                        <button type="button" onclick="cancel()" class="text-white btn icon-link icon-link-hover" asp-route-id="documet.getElementById('id').value" style="--bs-icon-link-transform: scale(1.5); transition: var(--bs-icon-link-transform) 0.3ease; background-color: orangered;"><i style="transition: transform 0.3s ease;" class="fa-solid fa-xmark bi"></i>Cancel</button>
                        <a  href="/Clients/Index" class="text-white btn icon-link icon-link-hover" style="--bs-icon-link-transform: translate3d(-.5rem, 0, 0); background-color: rgb(73, 0, 141);"><i class="fa-solid fa-backward bi"></i> Back To List</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<script>
    function cancel(){
        let ok = confirm("Do you doesn't want to edit");
        if(ok){
            window.location.href="/Clients/Index";
        }
    }
</script>