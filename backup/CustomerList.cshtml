<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer List</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class="bg-secondary">
    <div class="container-flex bg-light m-3">
        <div class="row p-4">
            <div class="col-6"  >
                <h1>Customer List</h1>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <button class="btn btn-secondary me-4 btn-sm" onclick="nextPage()"><i class="fa-solid fa-plus"></i>New</button>
                <button class="btn btn-secondary "><i class="fa-solid fa-house-chimney"></i></button>
            </div>
        </div>
        <div class="row p-3">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="filter" class="form-laber">Filter</label>
                <select name="filter" class="form-select" id="filter">
                    <option value="" disabled selected>Select Branch</option>
                        <option value="R s Puram">R S Puram</option>
                        <option value="Ukkadam">Ukkadam</option>
                        <option value="Sundharapuram">Sundharapuram</option>
                        <option value="Pollachi">Pollachi</option>
                        <option value="Sulur">Sulur</option>
                </select>
            </div>
            <div class="table-responsive mt-5">
                    <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Customer Code</th>
                            <th>Customer Name</th>
                            <th>Contact No</th>
                            <th>Email</th>
                            <th>Area</th>
                            <th>Address</th>
                            <th>Branch</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="tbody">
                        <tr>
                            <td>Customer Code</td>
                            <td>Customer Name</td>
                            <td>Contact No</td>
                            <td>Email</td>
                            <td>Area</td>
                            <td>Address</td>
                            <td>Branch</td>
                            <td>Status</td>
                            <td>
                                <button>
                                    Action 
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script>
        function nextPage() {
            window.location.href = "index.html"
        }
    </script>
</body>
</html>